// Cloudflare Workers の設定。web/ を静的サイトとして返し、/api/ だけ worker/index.js が受ける。
//   手元で動かす: npx wrangler@4 d1 migrations apply m5-stopwatch-face --local && npx wrangler@4 dev
//   確認:        npx wrangler@4 deploy --dry-run
//   公開:        npx wrangler@4 d1 migrations apply m5-stopwatch-face --remote && npx wrangler@4 deploy
// 秘密の値 (ADMIN_TOKEN など) はここには書かず、npx wrangler@4 secret put で入れる。
{
  "name": "m5-stopwatch-face",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // 独自ドメイン。これまでの workers.dev の URL も残す
  "routes": [{ "pattern": "m5stopwatch.lawrenceturnerw.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "m5-stopwatch-face", "database_id": "158118bf-30ea-4873-b172-a45d4559d374", "migrations_dir": "migrations" }
  ],
  // 同じ IP からの投稿・削除・通報は 1 分に 5 回まで
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
